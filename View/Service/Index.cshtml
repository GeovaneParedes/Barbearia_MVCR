@model IEnumerable<Barbearia_MVC.Models.Service>

@{
    ViewData["Title"] = "Services Catalog";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>💈 Services & Barber Shop Menu</h2>
        <a asp-action="Create" class="btn btn-primary">Add New Service</a>
    </div>

    <table class="table table-striped table-hover border">
        <thead class="table-dark">
            <tr>
                <th>Service Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var service in Model)
            {
                <tr>
                    <td class="fw-bold">@service.Name</td>
                    <td>@service.Description</td>
                    <td class="text-success fw-bold">$@service.Price.ToString("F2")</td>
                    <td>
                        <button class="btn btn-sm btn-warning">Edit Price</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
