@model Barbearia_MVC.Models.Appointment

@{
    ViewData["Title"] = "Checkout Balance";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow border-success">
        <div class="card-header bg-success text-white text-center py-3">
            <h3 class="mb-0">💵 POS Cashier - Checkout</h3>
        </div>
        <div class="card-body">
            
            <h5 class="text-muted mb-3 border-bottom pb-2">Ticket Summary</h5>
            <div class="row mb-4 fs-5">
                <div class="col-6 mb-2"><strong>Client:</strong></div>
                <div class="col-6 text-end">@Model.Customer.Name</div>
                
                <div class="col-6 mb-2"><strong>Barber:</strong></div>
                <div class="col-6 text-end">@Model.Barber.Name</div>
                
                <div class="col-6 mb-2"><strong>Service:</strong></div>
                <div class="col-6 text-end text-primary fw-bold">@Model.Service.Name</div>
                
                <div class="col-12"><hr /></div>
                
                <div class="col-6 fw-bold text-success fs-3">Total Due:</div>
                <div class="col-6 text-end text-success fw-bold fs-3">$@Model.Service.Price</div>
            </div>

            <!-- Formulário que envia o pagamento para a Action ProcessPayment -->
            <form asp-action="ProcessPayment" method="post">
                @Html.AntiForgeryToken()
                
                <!-- Passa o ID invisível para o controlador saber qual agendamento pagar -->
                <input type="hidden" name="appointmentId" value="@Model.Id" />
                <input type="hidden" name="amountPaid" value="@Model.Service.Price" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label class="form-label fw-bold fs-5">Select Payment Method</label>
                    <select name="paymentMethod" class="form-select form-select-lg" required>
                        <option value="" disabled selected>-- Choose method --</option>
                        <option value="Cash">Cash (Dinheiro)</option>
                        <option value="CreditCard">Credit Card (Cartão de Crédito)</option>
                        <option value="DebitCard">Debit Card (Cartão de Débito)</option>
                        <option value="Pix">Pix / Instant Transfer</option>
                    </select>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg">Complete Sale & Pay Barber</button>
                    <a href="/Appointment/Index" class="btn btn-outline-secondary">Go Back to Schedule</a>
                </div>
            </form>

        </div>
    </div>
</div>
